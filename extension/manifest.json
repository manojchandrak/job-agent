{
  "manifest_version": 3,
  "name": "job-agent companion",
  "version": "1.0.0",
  "description": "Save LinkedIn/Indeed jobs into job-agent, flag H-1B sponsor matches, and highlight application fields while you browse.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://www.linkedin.com/*",
    "https://www.indeed.com/*",
    "https://smartapply.indeed.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": ["content-linkedin.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.indeed.com/*", "https://smartapply.indeed.com/*"],
      "js": ["content-indeed.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
