# Copy to .env and fill in.

# Comma-separated Greenhouse board tokens, e.g. company slugs from
# https://boards.greenhouse.io/<token>
GREENHOUSE_BOARDS=

# Comma-separated Lever company slugs, e.g. https://jobs.lever.co/<slug>
LEVER_COMPANIES=

# Set to "true" to include these sources in every search
INCLUDE_REMOTEOK=true
INCLUDE_WWR=true
INCLUDE_MUSE=true

# Optional but recommended for broad US coverage (remote + onsite, many boards).
# Free key: https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
